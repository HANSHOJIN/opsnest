{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpsNest",
  "version": "0.2.0-alpha.4",
  "identifier": "com.opsnest.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpsNest",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"]
  }
}
